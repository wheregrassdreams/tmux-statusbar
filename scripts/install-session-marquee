#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manifest="$plugin_dir/session-marquee/Cargo.toml"
version="$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$manifest" | head -n 1)"
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64|Darwin-aarch64) target=aarch64-apple-darwin ;;
  Linux-x86_64|Linux-amd64) target=x86_64-unknown-linux-gnu ;;
  *) exit 1 ;;
esac

cache_root="${XDG_CACHE_HOME:-${HOME:?HOME must be set}/.cache}/tmux-statusbar/$version/$target"
binary="$cache_root/session-marquee"
[[ -x "$binary" ]] && { printf '%s\n' "$binary"; exit 0; }

if command -v shasum >/dev/null 2>&1; then
  checksum_tool=shasum
elif command -v sha256sum >/dev/null 2>&1; then
  checksum_tool=sha256sum
else
  exit 1
fi
release="https://github.com/wheregrassdreams/tmux-statusbar/releases/download/tmux-statusbar-v$version"
tag="tmux-statusbar-v$version"
asset="session-marquee-$version-$target"
mkdir -p "$cache_root"
tmp_dir="$(mktemp -d "$cache_root/.download.XXXXXX")"
tmp_binary="$tmp_dir/$asset"
tmp_checksum="$tmp_binary.sha256"
trap 'rm -f "$tmp_binary" "$tmp_checksum"; rmdir "$tmp_dir" 2>/dev/null || true' EXIT
if command -v gh >/dev/null 2>&1 && gh auth status --hostname github.com >/dev/null 2>&1; then
  gh release download "$tag" --repo wheregrassdreams/tmux-statusbar \
    --pattern "$asset" --pattern "$asset.sha256" --dir "$tmp_dir"
else
  command -v curl >/dev/null 2>&1 || exit 1
  curl --connect-timeout 5 --max-time 15 --fail --location --silent --show-error "$release/$asset" -o "$tmp_binary"
  curl --connect-timeout 5 --max-time 15 --fail --location --silent --show-error "$release/$asset.sha256" -o "$tmp_checksum"
fi

expected="$(cat "$tmp_checksum")"
if [[ "$checksum_tool" == shasum ]]; then
  actual="$(shasum -a 256 "$tmp_binary")"
else
  actual="$(sha256sum "$tmp_binary")"
fi
actual="${actual%% *}"
[[ "$actual" == "$expected" ]] || exit 1

chmod +x "$tmp_binary"
mv "$tmp_binary" "$binary"
printf '%s\n' "$binary"
